{
    "name": "codemonster-ru/datetime",
    "description": "Immutable date-time operations, strict parsing, timezone conversion, localization, business calendars, and PSR-20 clocks.",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "canonical": false,
            "options": {
                "symlink": true
            }
        }
    ],
    "homepage": "https://github.com/codemonster-ru/datetime",
    "authors": [
        {
            "name": "Kirill Kolesnikov",
            "email": "admin@codemonster.net",
            "homepage": "https://github.com/KolesnikovKirill",
            "role": "Lead Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Codemonster\\DateTime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codemonster\\DateTime\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit --colors=always --testdox"
    },
    "suggest": {
        "ext-intl": "Required for localized date-time and human interval formatting."
    },
    "keywords": [
        "php",
        "datetime",
        "date",
        "time",
        "timezone",
        "clock",
        "psr-20",
        "immutable",
        "localization",
        "business-calendar",
        "annabel",
        "codemonster"
    ],
    "support": {
        "issues": "https://github.com/codemonster-ru/datetime/issues",
        "source": "https://github.com/codemonster-ru/datetime"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
